# Frontend environment — copy to .env.local for local overrides. Never commit secrets.
#
# Local development: leave VITE_API_URL empty; the Vite dev server proxies /api
# to http://localhost:5000 (see vite.config.js).
#
# Production (Cloudflare Pages): set VITE_API_URL to the deployed Vercel API
# including the /api path, for example:
# VITE_API_URL=https://your-project-api.vercel.app/api
#
# Only public values belong here. Never put GROQ_API_KEY, GEMINI_API_KEY,
# MONGO_URI/MONGODB_URI, JWT_SECRET, GITHUB_TOKEN or storage secrets in VITE_ variables.

VITE_API_URL=
