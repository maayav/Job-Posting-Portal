# Backend environment — copy to .env and fill in real values. Never commit .env.
#
# Vercel: set these as server-side project environment variables.
# MONGO_URI or MONGODB_URI (either name is accepted).

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/placement_skill_gap
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API.
# Production: CLIENT_URL=https://vortex-6g7.pages.dev
CLIENT_URL=

# Groq — required for skill extraction, study plans and the AI assistant
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Google AI (Gemini) — used only for skill embeddings
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_VERSION=2026-09

# GitHub — optional but recommended (higher rate-limit tier)
GITHUB_TOKEN=

AI_TEXT_PROVIDER=groq
AI_EMBEDDING_PROVIDER=gemini
AI_TEXT_FALLBACK_PROVIDER=none
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Local filesystem override (also used by isolated tests).
# On Vercel the default is per-instance /tmp/vortex-storage, not durable storage.
# Remote storage is not configured. Adding provider credentials alone does not
# enable an adapter or migrate existing resumes. See DEPLOYMENT.md.
# RESUME_STORAGE_DIR=

# Optional local-only read-only integration checks. Never use private profiles.
# INTEGRATION_TEST_GITHUB_USERNAME=
# INTEGRATION_TEST_LEETCODE_USERNAME=
