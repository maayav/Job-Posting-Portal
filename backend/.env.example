# Backend environment — copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/placement_skill_gap
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google AI (Gemini) — required
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_VERSION=2026-09

# GitHub — optional but recommended (higher rate-limit tier)
GITHUB_TOKEN=GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview
