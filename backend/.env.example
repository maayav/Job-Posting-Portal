# Backend environment — copy to .env and fill in real values. Never commit .env.
#
# Render: set these as service environment variables instead of a file.
# MONGO_URI or MONGODB_URI (either name works; MONGODB_URI matches Atlas/Render docs).

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/placement_skill_gap
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API.
# Production example: CLIENT_URL=https://your-project.vercel.app
CLIENT_URL=

# Groq — required for skill extraction, study plans and the AI assistant
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Google AI (Gemini) — used only for skill embeddings
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_VERSION=2026-09

# GitHub — optional but recommended (higher rate-limit tier)
GITHUB_TOKEN=

AI_TEXT_PROVIDER=groq
AI_EMBEDDING_PROVIDER=gemini
AI_TEXT_FALLBACK_PROVIDER=none
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional persistent resume storage (Cloudinary). Leave blank to keep the
# default local backend/storage directory, which is ephemeral on Render.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=